# URLs del backend Burger Beats para la app TPV.
# Se incrustan en el bundle al compilar (variables EXPO_PUBLIC_*).
# Cambiarlas requiere reiniciar Metro con cache limpia y recompilar el APK.
#
# Desde la app: Ajustes -> SINCRONIZACION -> Servidor permite elegir entre
# "Produccion" (URL fija, la de abajo) y "Local" (editable en la propia app).
# Lo elegido se guarda en el dispositivo y manda sobre estos valores.
#
# Emulador Android   -> localhost del PC es http://10.0.2.2
# Dispositivo fisico -> IP LAN del PC, p.ej. http://192.168.0.65
# Laragon vhost      -> http://burger-beats-backend.test (solo desde el propio PC)
#
# Para reapuntar a una IP nueva:  powershell -ExecutionPolicy Bypass -File scripts\update-lan-ip.ps1

# --- PRODUCCION (no editable desde la app) ---
EXPO_PUBLIC_PROD_API_BASE_URL=https://burguerbeats.com

# --- LOCAL / PRUEBAS (valor inicial; editable desde Ajustes) ---
# Si esta linea tiene valor, la app arranca por defecto en modo "Local".
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.65
