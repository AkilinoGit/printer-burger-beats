# URL base del backend Burger Beats para la app TPV.
# Se incrusta en el bundle al compilar (variables EXPO_PUBLIC_*).
# Cambiarla requiere reiniciar Metro con caché limpia y recompilar el APK.
#
# Emulador Android -> localhost del PC es http://10.0.2.2
# Dispositivo físico -> IP LAN del PC, p.ej. http://192.168.0.65
# Laragon vhost      -> http://burger-beats-backend.test (solo accesible desde el propio PC)
#
# Para reapuntar a una IP nueva:  powershell -ExecutionPolicy Bypass -File scripts\update-lan-ip.ps1
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.65
